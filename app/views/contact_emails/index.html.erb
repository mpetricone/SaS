<h1><%= t(:title_listing_for, items: ContactEmail.model_name.human(count: 2), for: @contact.full_name) %></h1>

<table>
  <thead>
    <tr>
      <th><%= t(:label_address) %></th>
      <th colspan="3"></th>
    </tr>
  </thead>

  <tbody>
    <% @contact_emails.each do |contact_email| %>
      <tr>
        <td><%= contact_email.address %></td>
        <td><%= link_to t(:button_show), contact_contact_email_path(@contact, contact_email.id )%></td>
        <td><%= link_to t(:button_edit), edit_contact_contact_email_path(@contact,contact_email) %></td>
        <td><%= link_to t(:button_destroy), contact_contact_email_path(@contact, contact_email.id), method: :delete, data: { confirm: t(:prompt_confirm) } %></td>
      </tr>
    <% end %>
  </tbody>
</table>

<br>

<%= link_to t(:button_new_for, item: ContactEmail.model_name.human), new_contact_contact_email_path %>
