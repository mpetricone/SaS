<h1><%= t(:title_listing, items: ExpensePayment.model_name.human(count: 2)) %></h1>

<table>
  <thead>
    <tr>
      <th><%= ExpensePayment.human_attribute_name(:amount) %></th>
      <th><%= ExpensePayment.human_attribute_name(:identifier) %></th>
      <th><%= ExpensePayment.human_attribute_name(:ou_payment_type) %></th>
      <th><%= ExpensePayment.human_attribute_name(:expense) %></th>
      <th colspan="3"></th>
    </tr>
  </thead>

  <tbody>
    <% @expense_payments.each do |expense_payment| %>
      <tr>
        <td><%= expense_payment.amount %></td>
        <td><%= expense_payment.identifier %></td>
        <td><%= expense_payment.ou_payment_type %></td>
        <td><%= expense_payment.expense %></td>
        <td><%= link_to t(:button_show), expense_payment %></td>
        <td><%= link_to t(:button_edit), edit_expense_payment_path(expense_payment) %></td>
        <td><%= link_to t(:button_destroy), expense_payment, method: :delete, data: { confirm: t(:prompt_confirm) } %></td>
      </tr>
    <% end %>
  </tbody>
</table>

<br>

<%= link_to t(:button_new_for, item: ExpensePayment.model_name.human), new_expense_payment_path %>
