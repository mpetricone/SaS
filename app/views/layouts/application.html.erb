<!DOCTYPE html>
<html lang='en'>
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
    <meta name="turbo-cache-control" content="no-preview">
    <title>Sas</title>
    <%= javascript_include_tag( 'application', 'data-turbolinks-track': 'reload') %>
    <%= stylesheet_link_tag( 'application', media: 'all', 'data-turbolinks-track': true)%>
    <%= csrf_meta_tags %>
  </head>
  <body>
    <div class='container-fluid'>
      <div class="toast-container position-fixed top-0 end-0 p-3 mt-5" style="z-index: 1200">
        <% flash.each do |key, msg| %>
          <div class="toast align-items-center <%= flash_toast_class(key) %> border-0"
               role="alert"
               aria-live="assertive"
               aria-atomic="true"
               data-controller="flash">
            <div class="d-flex">
              <div class="toast-body"><%= msg %></div>
              <button type="button" class="btn-close btn-close-white me-2 m-auto" data-action="click->flash#close" aria-label="Close"></button>
            </div>
          </div>
        <% end %>
        <%= yield :validation_toast %>
      </div>

      <%= render partial: 'shared/nav/main_navbar' %>

      <%= yield %>

      <% if not params[:hide_user] %>
        <div class='d-none navbar navbar-expand-lg fixed-bottom justify-content-between navbar-light bg-light'>
          <div class='container'>
            <%= link_to 'SaS', home_index_path, class: 'navbar-brand' %>
            <%= link_to(ficon('home', "Go Home!"), home_index_path, class: 'navbar-text') %>
            <div class='navbar-text copyright'><%= Version::Version.copyright_version %></div>
          </div>
        </div>
      <% end %>
    </div><!-- container-->
  </body>
</html>
