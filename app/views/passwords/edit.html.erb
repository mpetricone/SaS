<div class="row justify-content-center">
  <div class="col-6">
    <div class="card">
      <h1 class="card-header"><%= t(:title_set_password) %></h1>
      <div class="card-body">
        <% if @employee.errors.any? %>
          <div class="alert alert-danger">
            <ul class="mb-0">
              <% @employee.errors.full_messages.each do |msg| %>
                <li><%= msg %></li>
              <% end %>
            </ul>
          </div>
        <% end %>
        <%= form_with(url: password_path(params[:token]), method: :patch, local: true, class: 'form-horizontal') do |f| %>
          <div class='form-group'>
            <%= label_tag :password, t(:label_new_password), class: 'col-xs-5 control-label' %>
            <div class='col-xs-7'>
              <%= password_field_tag :password, nil, class: 'form-control' %>
            </div>
          </div>
          <div class='form-group'>
            <%= label_tag :password_confirmation, t(:label_confirm_password), class: 'col-xs-5 control-label' %>
            <div class='col-xs-7'>
              <%= password_field_tag :password_confirmation, nil, class: 'form-control' %>
            </div>
          </div>
          <div class='form-group d-flex justify-content-center p-2'>
            <%= button_tag t(:button_set_password), type: 'submit', class: 'btn btn-primary btn-block' %>
          </div>
        <% end %>
      </div>
    </div>
  </div>
</div>
