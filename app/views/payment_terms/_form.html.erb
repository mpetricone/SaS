<%= render partial: 'shared/error_form_uc', locals: { result: @payment_term, object_name: PaymentTerm.model_name.human, object_action: form_action } %>
<%= form_for @payment_term do |f| %>
  <div class='row'>
    <%= render_field_group f, t(:label_primary_info),
        [{ label: :name,        name: :name,        type: :text_field },
         { label: :description, name: :description, type: :text_area },
         { label: :active,      name: :active,      type: :check_box }] %>
  </div>
  <%= render_actions f, payment_terms_path %>
<% end %>
