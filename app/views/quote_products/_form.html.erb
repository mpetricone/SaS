<%= form_with model: [@quote, @quote_product], local: true do |f| %>
  <% if @quote_product.errors.any? %>
    <div class='alert alert-danger'><%= @quote_product.errors.full_messages.to_sentence %></div>
  <% end %>

  <div class='row g-3'>
    <div class='col-md-6'>
      <%= f.label :product_id, Product.model_name.human, class: 'form-label' %>
      <%= f.collection_select :product_id, Product.order(:name), :id, :name, { include_blank: true }, class: 'form-select' %>
    </div>
    <div class='col-md-3'>
      <%= f.label :quantity, class: 'form-label' %>
      <%= f.number_field :quantity, class: 'form-control', min: 1 %>
    </div>
    <div class='col-md-3'>
      <%= f.label :price, class: 'form-label' %>
      <%= f.text_field :price, class: 'form-control' %>
    </div>
  </div>

  <div class='mt-3'>
    <%= f.submit t(:button_add_line_item), class: 'btn btn-primary' %>
    <%= link_to ficon('remove', 'Cancel'), quote_path(@quote), class: 'btn btn-danger' %>
  </div>
<% end %>
