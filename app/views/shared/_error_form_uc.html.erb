<% if result.errors.any? %>
  <% content_for :validation_toast do %>
    <div class="toast align-items-center toast-alert text-white border-0"
         role="alert"
         aria-live="assertive"
         aria-atomic="true"
         data-controller="flash">
      <div class="d-flex">
        <div class="toast-body">
          <%= t(:text_form_errors_pluralize, count: result.errors.count) %><%= t(:text_form_errors_check_highlighted) %>
        </div>
        <button type="button" class="btn-close btn-close-white me-2 m-auto" data-action="click->flash#close" aria-label="Close"></button>
      </div>
    </div>
  <% end %>
<% end %>
