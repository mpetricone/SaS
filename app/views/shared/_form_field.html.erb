<%# form: form var; field_label: label ; field field; it: input type , params [{:whatevs}] %>
<% if it == :breakpoint %>
  <div class='w-100'></div>
<% else %>
  <% error_keys = [field].compact %>
  <% error_keys << field.to_s.sub(/_id\z/, '').to_sym if field.to_s.end_with?('_id') %>
  <% has_error = error_keys.any? { |k| form.object&.errors&.[](k)&.any? } %>
  <%= content_tag :div, class: "col-auto mx-auto #{'field-group-error' if has_error}" do %>
    <% unless field_label==nil %>
      <%= form.label field_label %>:
    <% end %>
    <% case it %>
    <% when :collection_select %>
      <%= form.send(it, field, ext_params[:collection],ext_params[:value_method], ext_params[:text_method], options, html_options) %>
    <% when :time_select %>
      <%= form.send(it, field, options, html_options) %>
    <% else %>
      <%= form.send(it, field, options) %>
    <% end %>
    <% error_keys.flat_map { |k| form.object.errors.full_messages_for(k) }.uniq.each do |msg| %>
      <div class="field-error-message"><%= msg %></div>
    <% end %>
  <% end %>
<%end%>
