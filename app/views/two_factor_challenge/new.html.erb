<div class="row justify-content-center">
  <div class="col-6">
    <div class="card">
      <h1 class="card-header"><%= t(:title_two_factor_code) %></h1>
      <div class="card-body">
        <p><%= t(:text_2fa_challenge_help) %></p>
        <%= form_with(url: two_factor_challenge_path, method: :post, local: true, class: 'form-horizontal') do |f| %>
          <div class='form-group'>
            <%= label_tag :otp_code, t(:label_otp_code) %>
            <%= text_field_tag :otp_code, nil, class: 'form-control', autocomplete: 'one-time-code', autofocus: true %>
          </div>
          <div class='form-group d-flex justify-content-center p-2'>
            <%= button_tag t(:button_verify), type: 'submit', class: 'btn btn-primary' %>
          </div>
        <% end %>
      </div>
    </div>
  </div>
</div>
